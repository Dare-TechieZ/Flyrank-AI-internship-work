{
  "openapi": "3.0.0",
  "info": {
    "title": "Auth Login Protect API",
    "version": "1.0.0",
    "description": "Secure authentication API using Express and Supabase Auth"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Create user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "test@example.com",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "test@example.com",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Public endpoint",
        "responses": {
          "200": {
            "description": "Public Information"
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "User Profile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Dashboard",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}